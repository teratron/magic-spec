{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "allowJs": true,
    "noEmit": true,
    "module": "nodenext",
    "target": "es2022",
    "lib": [
      "es2023"
    ],
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "strict": false,
    "checkJs": false
  },
  "include": [
    "skills/magicspec/scripts/**/*.js",
    "skills/magicspec-dev/**/*.js",
    "scripts/**/*.js",
    "tests/**/*.js"
  ],
  "exclude": [
    "node_modules"
  ]
}