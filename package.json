{
  "private": true,
  "type": "commonjs",
  "description": "Development repository of Magic Spec, a Specification-Driven Development engine for AI coding agents: the engine skill, its maintenance scripts and the regression harness.",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "fallow": "fallow",
    "fallow:fix": "fallow fix",
    "audit": "fallow audit",
    "audit:ci": "fallow audit --format json",
    "audit:review": "fallow review --brief",
    "test": "node --test tests/engine.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "fallow": "^3.42.0"
  }
}
